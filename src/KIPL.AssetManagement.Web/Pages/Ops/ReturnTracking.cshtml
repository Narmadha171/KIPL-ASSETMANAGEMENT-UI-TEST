@page
@model KIPL.AssetManagement.Web.Pages.Ops.ReturnTrackingModel
@{
    ViewData["Title"] = "Returns tracking";
    var c = Model.Counts;
}

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Returns tracking</h1>
            <div class="page-sub">Follow assets coming back in, then inspect them to decide where they land.</div>
        </div>
    </div>

    <div class="kpi-row">
        <div class="kpi-card"><div class="kpi-badge tone-amber">@Icons.Svg("clock", 15)</div><div class="num">@c.AwaitingPickup</div><div class="lbl">AWAITING PICKUP</div></div>
        <div class="kpi-card"><div class="kpi-badge tone-signal">@Icons.Svg("truck", 15)</div><div class="num">@c.InTransit</div><div class="lbl">IN TRANSIT</div></div>
        <div class="kpi-card"><div class="kpi-badge tone-signal">@Icons.Svg("inbox", 15)</div><div class="num">@c.AwaitingInspection</div><div class="lbl">AWAITING INSPECTION</div></div>
        <div class="kpi-card"><div class="kpi-badge tone-success">@Icons.Svg("checkcheck", 15)</div><div class="num">@c.ClosedThisMonth</div><div class="lbl">CLOSED THIS MONTH</div></div>
    </div>

    <div class="panel">
        <div class="tabs">
            <a class="tab @(Model.Stage is null ? "active" : "")" asp-page="/Ops/ReturnTracking" style="text-decoration:none;">All returns</a>
            @foreach (var stage in Enum.GetValues<ReturnStage>())
            {
                <a class="tab @(Model.Stage == stage ? "active" : "")"
                   asp-page="/Ops/ReturnTracking" asp-route-Stage="@((int)stage)" style="text-decoration:none;">
                    @DisplayHelpers.Label(stage)
                </a>
            }
        </div>

        @if (Model.Returns.Count == 0)
        {
            <partial name="_Empty" model="@("No returns at this stage.")" />
        }
        else
        {
            <table>
                <thead>
                <tr>
                    <th>REFERENCE</th>
                    <th>EMPLOYEE</th>
                    <th>ASSET</th>
                    <th>MODE</th>
                    <th>STAGE</th>
                    <th>RAISED</th>
                    <th style="text-align:right;">ACTIONS</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Returns)
                {
                    <tr class="data-row">
                        <td class="mono" style="font-weight:600;">@r.Reference</td>
                        <td>@r.EmployeeName</td>
                        <td>
                            <div style="font-weight:600;">@r.AssetName</div>
                            <div style="margin-top:4px;"><span class="tag-chip">@r.AssetTag</span></div>
                        </td>
                        <td class="cell-muted">
                            @r.Mode
                            @if (r.TrackingNumber is not null)
                            {
                                <div class="mono" style="font-size:11px;">@r.TrackingNumber</div>
                            }
                            @if (r.DropOffLocation is not null)
                            {
                                <div style="font-size:11px;">@r.DropOffLocation</div>
                            }
                        </td>
                        <td><span class="@DisplayHelpers.PillClass(r.Stage)">@DisplayHelpers.Label(r.Stage)</span></td>
                        <td class="cell-muted">@DisplayHelpers.Relative(r.RaisedUtc)</td>
                        <td>
                            <div class="row-actions">
                                @if (Model.CanInspect && r.Stage is ReturnStage.AwaitingPickup or ReturnStage.InTransit)
                                {
                                    <form method="post" asp-page-handler="Receive">
                                        <input type="hidden" name="returnId" value="@r.Id" />
                                        <button type="submit" class="btn btn-outline btn-sm">Mark received</button>
                                    </form>
                                }
                                @if (Model.CanInspect && r.Stage != ReturnStage.Closed)
                                {
                                    <button type="button" class="btn btn-primary btn-sm"
                                            data-modal="inspectReturn"
                                            data-returnid="@r.Id"
                                            data-reference="@r.Reference"
                                            data-asset="@r.AssetName"
                                            data-tag="@r.AssetTag">Inspect</button>
                                }
                                @if (r.Stage == ReturnStage.Closed && r.InspectedCondition is not null)
                                {
                                    <span class="pill pill-success">@r.InspectedCondition</span>
                                }
                            </div>
                        </td>
                    </tr>

                }
                </tbody>
            </table>
        }
    </div>
</div>

@section Modals {
    <div class="modal-overlay" id="modal-inspectReturn">
        <div class="modal" style="width:420px;">
            <form method="post" asp-page-handler="Inspect" enctype="multipart/form-data" data-gate>
                <div class="modal-head">
                    <h3>Inspect Return</h3>
                    <button type="button" class="icon-btn" data-close-modal>✕</button>
                </div>

                <input type="hidden" name="returnId" data-input="returnid" value="0" />

                <div class="modal-context">
                    <div class="avatar">🔍</div>
                    <div>
                        <div style="font-weight:600; font-size:13px;" data-field="asset">—</div>
                        <div class="cell-muted mono" style="font-size:11.5px;">
                            <span data-field="tag">—</span> · <span data-field="reference">—</span>
                        </div>
                    </div>
                </div>

                <div class="modal-body">
                    <div class="field">
                        <label>Inspection decision</label>
                        <div class="choice-row" data-choice-group>
                            <input type="hidden" name="condition" data-gate-required />
                            <div class="choice" data-value="@((int)AssetCondition.Damaged)" style="padding:16px 6px; text-align:center;">🔧<br />Needs service</div>
                            <div class="choice" data-value="@((int)AssetCondition.Good)" style="padding:16px 6px; text-align:center;">🔄<br />Reset only</div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="inspectNotes">Inspection notes</label>
                        <textarea id="inspectNotes" name="notes" rows="3"
                                  placeholder="Scratches on the lid, battery health 82%…"></textarea>
                    </div>

                    <div class="field">
                        <label>Photo on arrival</label>
                        <div class="dropzone" id="inspectZone" data-for="inspectPhoto" data-label="📷 Capture or attach a photo">
                            📷 Capture or attach a photo
                        </div>
                        <input type="file" id="inspectPhoto" name="photo" accept="image/*" capture="environment"
                               data-zone="inspectZone" style="display:none;" />
                    </div>
                </div>

                <div class="modal-actions" style="margin-top:16px;">
                    <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                    <button type="submit" class="btn btn-primary" data-gate-target disabled>Close return</button>
                </div>
            </form>
        </div>
    </div>
}
