@using KIPL.AssetManagement.Domain.Enums
@using KIPL.AssetManagement.Web.Pages.Ops
@using Microsoft.AspNetCore.Mvc.Rendering
@model EditUserModalModel
@{
    var u = Model.User;
}
<div class="modal-overlay @(Model.OpenOnLoad ? "open" : "")" id="modal-editUser-@u.Id">
    <div class="modal">
        <form method="post" asp-page-handler="EditUser">
            <div class="modal-head">
                <div>
                    <h3>Edit user</h3>
                    <div class="cell-muted" style="font-size:11.5px; margin-top:4px;">@u.FullName · @u.Email</div>
                </div>
                <button type="button" class="icon-btn" data-close-modal>✕</button>
            </div>

            <input type="hidden" name="EditInput.Id" value="@u.Id" />

            <div class="modal-context">
                <div class="avatar">@DisplayHelpers.Initials(u.FullName)</div>
                <div>
                    <div style="font-weight:600; font-size:13px;">@u.FullName</div>
                    <span class="@DisplayHelpers.PillClass(u.Status)">@u.Status</span>
                </div>
            </div>

            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>

                <div class="field">
                    <label>Full name</label>
                    <input name="EditInput.FullName" value="@u.FullName" />
                </div>

                <div class="field">
                    <label>Work email</label>
                    <input name="EditInput.Email" type="email" value="@u.Email" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Role</label>
                        <select name="EditInput.RoleName">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role" selected="@(u.RoleName == role)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Status</label>
                        <select name="EditInput.Status">
                            @foreach (var value in Enum.GetValues<UserStatus>())
                            {
                                <option value="@((int)value)" selected="@(u.Status == value)">@value</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label>Reporting manager</label>
                    <select name="EditInput.ManagerId">
                        <option value="">— none —</option>
                        @foreach (SelectListItem item in Model.Managers)
                        {
                            <option value="@item.Value" selected="@(item.Value == u.ManagerId?.ToString())">@item.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="modal-actions" style="margin-top:16px;">
                <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>

        <form method="post" asp-page-handler="Deactivate" data-confirm="Deactivate this account?" style="margin:10px 0 0;">
            <input type="hidden" name="id" value="@u.Id" />
            <button type="submit" class="linkish" style="font-size:12px;">Deactivate account</button>
        </form>
    </div>
</div>
