@* Employee confirms an online-ordered item arrived — the asset already has a tag/brand/model
   because HR verified the delivery before dispatch, so this is a read-only presentational
   variant of _ProofOfReceiptModal rather than a data-entry form. *@
<div class="modal-overlay" id="modal-proofOfReceiptOnline">
    <div class="modal" style="width:400px;">
        <form method="post" asp-page-handler="Confirm" enctype="multipart/form-data">
            <div class="modal-head">
                <div>
                    <div class="cell-muted" style="font-size:11px; letter-spacing:.04em; text-transform:uppercase;">Delivered — action needed</div>
                    <h3 style="margin-top:4px;">Confirm receipt</h3>
                    <div class="cell-muted" style="font-size:11.5px; margin-top:2px;" data-field="orderline">—</div>
                </div>
                <button type="button" class="icon-btn" data-close-modal>✕</button>
            </div>

            <input type="hidden" name="RequestId" data-input="requestid" value="0" />

            <div class="modal-context">
                <div class="avatar">📦</div>
                <div>
                    <div style="font-weight:600; font-size:13px;" data-field="item">—</div>
                    <div class="cell-muted mono" style="font-size:11.5px;" data-field="orderid">—</div>
                </div>
            </div>

            <div class="modal-body">
                <div style="font-size:13px; color:var(--ink-soft);">
                    HR already verified this order when it arrived — confirming tells IT the asset is with you.
                </div>

                <div class="field">
                    <label>Photo of the item as received <span class="cell-muted" style="font-weight:500;">— optional</span></label>
                    <div class="dropzone" id="receiptOnlineZone" data-for="receiptOnlinePhoto" data-label="📷 Capture or attach a photo">
                        📷 Capture or attach a photo
                    </div>
                    <input type="file" id="receiptOnlinePhoto" name="Photo" accept="image/*" capture="environment"
                           data-zone="receiptOnlineZone" style="display:none;" />
                </div>

                <div class="field">
                    <label>Condition note <span class="cell-muted" style="font-weight:500;">— optional</span></label>
                    <textarea rows="2" placeholder="Any visible damage or comments"></textarea>
                </div>
            </div>

            <div class="modal-actions" style="margin-top:16px;">
                <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-success">Confirm receipt</button>
            </div>
        </form>
    </div>
</div>
