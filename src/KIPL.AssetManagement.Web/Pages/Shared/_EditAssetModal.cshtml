@using KIPL.AssetManagement.Application.Inventory
@model EditAssetModalModel
@{
    var a = Model.Asset;
}
<div class="modal-overlay @(Model.OpenOnLoad ? "open" : "")" id="modal-editAsset-@a.Id">
    <div class="modal">
        <form method="post" asp-page-handler="SaveAsset">
            <div class="modal-head">
                <div>
                    <h3>Edit asset</h3>
                    <div class="cell-muted mono" style="font-size:11.5px; margin-top:4px;">@a.Tag · Asset #@a.Id</div>
                </div>
                <button type="button" class="icon-btn" data-close-modal>✕</button>
            </div>

            <input type="hidden" name="Input.Id" value="@a.Id" />

            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>

                <div class="banner banner-info" style="margin-bottom:14px;">
                    This edit will be logged in the asset's audit trail.
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Asset type</label>
                        <select name="Input.Category">
                            @foreach (var value in Enum.GetValues<AssetCategory>())
                            {
                                <option value="@((int)value)" selected="@(a.Category == value)">
                                    @DisplayHelpers.Label(value)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Condition</label>
                        <select name="Input.Condition">
                            @foreach (var value in Enum.GetValues<AssetCondition>())
                            {
                                <option value="@((int)value)" selected="@(a.Condition == value)">@value</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Asset ID <span class="cell-muted" style="font-weight:500;">— system-assigned</span></label>
                        <input class="mono" value="AST-@(a.Id.ToString("D4"))" disabled />
                    </div>
                    <div class="field">
                        <label>Asset tag</label>
                        <input name="Input.Tag" class="mono" value="@a.Tag" />
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Brand</label>
                        <input name="Input.Brand" value="@a.Brand" placeholder="Dell" required />
                    </div>
                    <div class="field">
                        <label>Model</label>
                        <input name="Input.Model" value="@a.Model" placeholder="Latitude 5440" />
                    </div>
                </div>

                <div class="field">
                    <label>Serial number</label>
                    <input name="Input.SerialNumber" class="mono" value="@a.SerialNumber" placeholder="Manufacturer serial" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Price</label>
                        <input name="Input.PurchaseCost" type="number" step="0.01" min="0" value="@a.PurchaseCost" placeholder="0.00" />
                    </div>
                    <div class="field">
                        <label>Warranty until</label>
                        <input name="Input.WarrantyExpiry" type="date" value="@(a.WarrantyExpiry?.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Purchase date</label>
                        <input name="Input.PurchaseDate" type="date" value="@(a.PurchaseDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="field">
                        <label>Location</label>
                        <input name="Input.Location" value="@a.Location" placeholder="Head office" />
                    </div>
                </div>

                <div class="field">
                    <label>Notes</label>
                    <textarea name="Input.Notes" rows="2">@a.Notes</textarea>
                </div>
            </div>

            <div class="modal-actions" style="margin-top:16px;">
                <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>
