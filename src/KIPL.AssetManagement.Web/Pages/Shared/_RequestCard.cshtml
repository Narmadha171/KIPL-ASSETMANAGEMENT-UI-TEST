@using KIPL.AssetManagement.Application.Requests
@using KIPL.AssetManagement.Domain.Enums
@model RequestListItemDto
@{
    // Progress mirrors the prototype: pending 15, unclaimed 35, claimed 55,
    // dispatched 85, completed 100.
    var pct = Model.Status switch
    {
        RequestStatus.Pending => 15,
        RequestStatus.Unclaimed => 35,
        RequestStatus.Claimed or RequestStatus.OnlineOrdered => 55,
        RequestStatus.Dispatched => 85,
        RequestStatus.Completed => 100,
        _ => 0
    };
    var awaitingReceipt = Model.Status == RequestStatus.Dispatched;
}
<div class="req-card @(Model.Status == RequestStatus.Completed ? "done" : "")" style="margin-bottom:12px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <div style="font-weight:600; font-size:13.5px;">
            @DisplayHelpers.Emoji(Model.Category) @Model.ItemName
        </div>
        <span class="@DisplayHelpers.PillClass(Model.Status)">@DisplayHelpers.Label(Model.Status)</span>
    </div>

    <div class="bar-track">
        <div class="bar-fill" style="width:@(pct)%; @(awaitingReceipt ? "background:var(--amber);" : "")"></div>
    </div>

    @if (Model.Status == RequestStatus.Rejected && Model.RejectionReason is not null)
    {
        <div class="cell-muted" style="font-size:12px; margin-top:9px;">@Model.RejectionReason</div>
    }
    @if (Model.TrackingNumber is not null && awaitingReceipt)
    {
        <div class="cell-muted mono" style="font-size:11.5px; margin-top:9px;">AWB @Model.TrackingNumber</div>
    }
    @if (Model.PickupLocation is not null && awaitingReceipt)
    {
        <div class="cell-muted" style="font-size:11.5px; margin-top:9px;">Collect from @Model.PickupLocation</div>
    }

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px; font-size:12px; color:var(--ink-faint);">
        <span>Requested @Model.RaisedUtc.ToLocalTime().ToString("d MMM")</span>

        @if (awaitingReceipt)
        {
            <button type="button" class="btn btn-primary btn-sm"
                    data-modal="@(Model.Source == RequestSource.Online ? "proofOfReceiptOnline" : "proofOfReceipt")"
                    data-requestid="@Model.Id"
                    data-item="@Model.ItemName"
                    data-tag="@(Model.AssetTag ?? "—")"
                    data-orderid="@(Model.OrderId ?? Model.AssetTag ?? "—")"
                    data-orderline="@($"Ordered online · #REQ-{Model.Id:D3}")">Confirm receipt</button>
        }
        else if (Model.Status == RequestStatus.Pending)
        {
            <form method="post" asp-page-handler="Cancel" style="margin:0;"
                  data-confirm="Cancel this request?">
                <input type="hidden" name="requestId" value="@Model.Id" />
                <button type="submit" class="linkish" style="color:var(--danger);">Cancel request</button>
            </form>
        }
    </div>
</div>
