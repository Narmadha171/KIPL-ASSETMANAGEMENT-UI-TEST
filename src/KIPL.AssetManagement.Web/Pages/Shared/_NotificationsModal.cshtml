@using KIPL.AssetManagement.Application.Notifications
@model IReadOnlyList<NotificationItemDto>

<div class="modal-overlay" id="modal-notificationsModal" role="dialog" aria-modal="true" aria-labelledby="notificationsModalTitle">
    <div class="modal notif-modal" style="width: 460px; max-width: 95vw;">
        <div class="modal-head" style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line);">
            <div style="display:flex; align-items:center; gap:9px;">
                <div class="kpi-badge tone-signal" style="margin:0; width:28px; height:28px;">
                    @Icons.Svg("bell", 15)
                </div>
                <div>
                    <h3 id="notificationsModalTitle" style="font-size: 15.5px; font-weight:700;">Notifications</h3>
                </div>
                @if (Model != null && Model.Count > 0)
                {
                    <span class="pill pill-signal notif-count-pill" style="font-size: 10px; padding: 2px 7px;">@Model.Count new</span>
                }
            </div>
            <div style="display:flex; align-items:center; gap:6px;">
                @if (Model != null && Model.Count > 0)
                {
                    <button type="button" class="linkish notif-mark-read" id="btnMarkAllRead" style="font-size: 11.5px; color: var(--ink-faint);">
                        Clear all
                    </button>
                }
                <button type="button" class="icon-btn" data-close-modal title="Close" aria-label="Close">✕</button>
            </div>
        </div>

        <div class="notif-list" id="notifContainer" style="display:flex; flex-direction:column; gap:10px; max-height: 60vh; overflow-y: auto; padding-right: 4px;">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var notif in Model)
                {
                    var toneClass = notif.Tone switch
                    {
                        "amber" => "tone-amber",
                        "danger" => "tone-danger",
                        "success" => "tone-success",
                        _ => "tone-signal"
                    };

                    <div class="notif-item @(notif.IsUrgent ? "urgent" : "")" data-notif-id="@notif.Id">
                        <div class="kpi-badge @toneClass" style="margin:0; width:34px; height:34px; border-radius: 9px; flex-shrink:0;">
                            @Icons.Svg(notif.Icon, 17)
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px; margin-bottom:2px;">
                                <span class="notif-title">@notif.Title</span>
                                <span class="notif-time">@notif.TimeAgo</span>
                            </div>
                            <p class="notif-desc">@notif.Message</p>
                            @if (!string.IsNullOrEmpty(notif.TargetUrl))
                            {
                                <div style="margin-top: 6px;">
                                    <a href="@notif.TargetUrl" class="notif-action-link">
                                        Take action &rarr;
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="notif-empty" id="notifEmptyState">
                    <div style="font-size: 28px; margin-bottom: 6px;">🎉</div>
                    <div style="font-weight: 600; font-size: 13.5px;">All caught up!</div>
                    <div class="cell-muted" style="font-size: 11.5px; margin-top: 3px;">You have no new notifications right now.</div>
                </div>
            }
        </div>
    </div>
</div>
