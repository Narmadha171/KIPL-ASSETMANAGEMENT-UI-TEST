@page
@model KIPL.AssetManagement.Web.Pages.Me.AssetsModel
@{
    ViewData["Title"] = "My assets";
}

@section TopActions {
    <button type="button" class="btn btn-outline btn-sm" data-modal="raiseReturnFromAssets">
        @Icons.Svg("undo", 15) Return an asset
    </button>
    <a class="btn btn-primary btn-sm" asp-page="/Me/Requests">@Icons.Svg("plus", 15) Request an asset</a>
}

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">My Assets</h1>
            <div class="page-sub">@Model.Assets.Count item(s) currently in your name.</div>
        </div>
    </div>

    @if (Model.Assets.Count == 0)
    {
        <div class="panel">
            <partial name="_Empty" model="@("Nothing is assigned to you yet. Raise a request and it will appear here once dispatched.")" />
        </div>
    }
    else
    {
        <div class="asset-grid">
            @foreach (var a in Model.Assets)
            {
                <div class="asset-card">
                    <div class="asset-icon">@DisplayHelpers.Emoji(a.Category)</div>
                    <div class="asset-name">@a.Brand</div>
                    <div style="margin-top:8px;"><span class="tag-chip">@a.Tag</span></div>
                    <div class="cell-muted" style="font-size:11.5px; margin-top:8px;">
                        @DisplayHelpers.Label(a.Category) · @a.Condition
                    </div>

                    <div style="display:flex; gap:6px; margin-top:14px;">
                        <button type="button" class="btn btn-outline btn-sm"
                                data-modal="reportIssue"
                                data-assetid="@a.Id"
                                data-brand="@a.Brand"
                                data-tag="@a.Tag">Report an issue</button>
                        <a class="btn btn-outline btn-sm" asp-page="/Me/Returns" asp-route-assetId="@a.Id">Return</a>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.MyIssues.Count > 0)
    {
        <div class="panel" style="margin-top:16px;">
            <div class="panel-head"><h3>Issues I have reported</h3></div>
            <table>
                <thead>
                <tr><th>REFERENCE</th><th>ASSET</th><th>ISSUE</th><th>URGENCY</th><th>STATUS</th><th>RAISED</th></tr>
                </thead>
                <tbody>
                @foreach (var s in Model.MyIssues)
                {
                    <tr class="data-row">
                        <td class="mono" style="font-weight:600;">@s.Reference</td>
                        <td>@s.AssetName <span class="tag-chip" style="margin-left:6px;">@s.AssetTag</span></td>
                        <td>
                            <div style="font-weight:600;">@s.IssueType</div>
                            <div class="cell-muted" style="font-size:11.5px;">@s.Description</div>
                        </td>
                        <td><span class="@DisplayHelpers.PillClass(s.Urgency)">@DisplayHelpers.Label(s.Urgency)</span></td>
                        <td class="cell-muted">
                            @s.Status
                            @if (s.Resolution is not null)
                            {
                                <div style="font-size:11px;">@s.Resolution</div>
                            }
                        </td>
                        <td class="cell-muted">@DisplayHelpers.Relative(s.RaisedUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Modals {
    <div class="modal-overlay" id="modal-reportIssue">
        <div class="modal">
            <form method="post" asp-page-handler="Report">
                <div class="modal-head">
                    <h3>Report an issue</h3>
                    <button type="button" class="icon-btn" data-close-modal>✕</button>
                </div>

                <input type="hidden" name="assetId" data-input="assetid" value="0" />

                <div class="modal-context">
                    <div class="avatar">🔧</div>
                    <div>
                        <div style="font-weight:600; font-size:13px;" data-field="brand">—</div>
                        <div class="cell-muted mono" style="font-size:11.5px;" data-field="tag">—</div>
                    </div>
                </div>

                <div class="modal-body">
                    <div class="field-row">
                        <div class="field">
                            <label for="issueType">What is affected?</label>
                            <select id="issueType" name="issueType">
                                <option>Battery</option>
                                <option>Screen</option>
                                <option>Keyboard</option>
                                <option>Performance</option>
                                <option>Connectivity</option>
                                <option>Physical damage</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="issueUrgency">Urgency</label>
                            <select id="issueUrgency" name="urgency">
                                <option value="@((int)ServiceUrgency.Minor)">Minor annoyance</option>
                                <option value="@((int)ServiceUrgency.AffectsMyWork)">Affects my work</option>
                                <option value="@((int)ServiceUrgency.CannotWork)">I can't work</option>
                            </select>
                        </div>
                    </div>

                    <div class="field">
                        <label for="issueDescription">What is happening?</label>
                        <textarea id="issueDescription" name="description" rows="4" required
                                  placeholder="Describe the fault and when it started."></textarea>
                    </div>
                </div>

                <div class="modal-actions" style="margin-top:16px;">
                    <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                    <button type="submit" class="btn btn-primary">Report issue</button>
                </div>
            </form>
        </div>
    </div>

    @* Returns are raised on their own screen, which owns the handler. *@
    <div class="modal-overlay" id="modal-raiseReturnFromAssets">
        <div class="modal" style="width:380px;">
            <div class="modal-head">
                <h3>Return an asset</h3>
                <button type="button" class="icon-btn" data-close-modal>✕</button>
            </div>
            <div style="font-size:13px; color:var(--ink-soft); margin-bottom:16px;">
                Returns are raised from the My Returns screen, where you choose how to hand the item back.
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                <a class="btn btn-primary" asp-page="/Me/Returns" style="flex:1; justify-content:center;">Go to My Returns</a>
            </div>
        </div>
    </div>
}
