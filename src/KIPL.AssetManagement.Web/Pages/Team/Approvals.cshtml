@page
@using KIPL.AssetManagement.Web.Pages.Shared
@model KIPL.AssetManagement.Web.Pages.Team.ApprovalsModel
@{
    ViewData["Title"] = "Team Approvals";
}

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Team Approvals</h1>
            <div class="page-sub" style="color:var(--danger); display:flex; align-items:center; gap:6px;">
                <span style="width:6px; height:6px; border-radius:999px; background:var(--danger); display:inline-block;"></span>
                @Model.Pending.Count request@(Model.Pending.Count == 1 ? "" : "s") waiting on your review
            </div>
        </div>
    </div>

    @if (Model.Pending.Count == 0)
    {
        <div class="panel" style="text-align:center; padding:36px; color:var(--ink-faint);">
            No pending approvals right now.
        </div>
    }
    else
    {
        @foreach (var r in Model.Pending)
        {
            <partial name="_ApprovalCard"
                     model="@(new ApprovalCardModel(r, Model.CanApprove, false, Model.NeedsAdmin(r)))" />
        }
    }

    @if (Model.Decided.Count > 0)
    {
        <h3 style="font-size:14px; margin:24px 0 10px;">Already decided</h3>
        <div class="panel">
            <table>
                <thead>
                <tr><th>REQUESTER</th><th>ITEM</th><th>STATUS</th><th>RAISED</th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Decided.Take(25))
                {
                    <tr class="data-row">
                        <td>@r.RequesterName</td>
                        <td style="font-weight:600;">@DisplayHelpers.Emoji(r.Category) @r.ItemName</td>
                        <td>
                            <span class="@DisplayHelpers.PillClass(r.Status)">@DisplayHelpers.Label(r.Status)</span>
                            @if (r.RejectionReason is not null)
                            {
                                <div class="cell-muted" style="font-size:11px; margin-top:4px;">@r.RejectionReason</div>
                            }
                        </td>
                        <td class="cell-muted">@DisplayHelpers.Relative(r.RaisedUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Modals {
    @* Managers approve and reject only — no fulfilment route from here. *@
    <div class="modal-overlay" id="modal-rejectRequest">
        <div class="modal" style="width:400px;">
            <form method="post" asp-page-handler="Reject">
                <div class="modal-head">
                    <h3>Reject request</h3>
                    <button type="button" class="icon-btn" data-close-modal>✕</button>
                </div>

                <input type="hidden" name="requestId" data-input="requestid" value="0" />

                <div class="modal-context">
                    <div class="avatar">!</div>
                    <div>
                        <div style="font-weight:600; font-size:13px;" data-field="item">—</div>
                        <div class="cell-muted" style="font-size:11.5px;">
                            Requested by <span data-field="requester">—</span>
                        </div>
                    </div>
                </div>

                <div class="field">
                    <label for="teamRejectReason">Why are you rejecting this?</label>
                    <textarea id="teamRejectReason" name="reason" rows="4" required
                              placeholder="The requester sees this, so be specific."></textarea>
                </div>

                <div class="modal-actions" style="margin-top:16px;">
                    <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject request</button>
                </div>
            </form>
        </div>
    </div>
}
