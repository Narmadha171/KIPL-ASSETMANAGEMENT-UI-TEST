<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>KIPL.AssetManagement.Web</RootNamespace>
    <UserSecretsId>kipl-assetmanagement-web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.10" />
    <!-- Tools supplies the Package Manager Console cmdlets (Add-Migration, Update-Database). -->
